---
import Header from "../components/Header.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Esteban VL - Desarrollador Full Stack en Barranquilla. Especialista en desarrollo web, React, Next.js, TypeScript. +4 años de experiencia creando aplicaciones web únicas y escalables." />
    <meta name="keywords" content="desarrollador barranquilla, Joel Viloria, Esteban VL, desarrollador web, full stack developer, React developer, Next.js developer, TypeScript, desarrollo de software, programador Colombia, frontend developer, backend developer, desarrollador JavaScript" />
    <meta name="author" content="Esteban VL" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="es" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://estebanvl.dev/" />
    <meta property="og:title" content="Esteban VL - Desarrollador Full Stack Barranquilla" />
    <meta property="og:description" content="Desarrollador Full Stack con +4 años de experiencia. Especializado en React, Next.js, TypeScript. Desarrollo de aplicaciones web modernas y escalables." />
    <meta property="og:image" content="/images/profesionall-photo.png" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://estebanvl.dev/" />
    <meta name="twitter:title" content="Esteban VL - Desarrollador Full Stack Barranquilla" />
    <meta name="twitter:description" content="Desarrollador Full Stack con +4 años de experiencia. Especializado en React, Next.js, TypeScript." />
    <meta name="twitter:image" content="/images/profesionall-photo.png" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://estebanvl.dev/" />
    
    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Esteban VL",
      "alternateName": "Joel Viloria",
      "jobTitle": "Full Stack Developer",
      "address": {
        "@type": "Address",
        "addressLocality": "Barranquilla",
        "addressCountry": "Colombia"
      },
      "url": "https://estebanvl.dev/",
      "sameAs": [
        "https://www.linkedin.com/in/esteban-vl-8a1333223/",
        "https://github.com/estebanvl07"
      ],
      "description": "Desarrollador Full Stack con +4 años de experiencia en desarrollo de aplicaciones web modernas y escalables.",
      "knowsAbout": ["React", "Next.js", "TypeScript", "JavaScript", "Tailwind CSS", "Node.js", "Desarrollo Web", "Full Stack Development"]
    }
    </script>
  </head>
  <body class="bg-[#050004]">
    <Header />
    <slot />
    
    <!-- Botón WhatsApp flotante -->
    <a
      href="https://wa.me/573001924603"
      target="_blank"
      aria-label="whatsapp"
      class="fixed bottom-6 right-6 flex items-center justify-center w-14 h-14 rounded-full bg-green-500 hover:bg-green-600 transition-all duration-300 hover:scale-110 shadow-lg z-50"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="white">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
  </body>
</html>
<style is:global>
  :root {
    color-scheme: dark;
    font-family: "Montserrat";
    scroll-behavior: smooth;
  }

  .font-montserrat {
    font-family: "Montserrat", sans-serif;
    font-optical-sizing: auto;
    font-weight: <weight>;
    font-style: normal;
  }

  .font-title {
    font-family: "Nothing You Could Do", cursive;
    font-weight: 400;
    font-style: normal;
  }

  .fade-bottom {
    mask-image: linear-gradient(black 80%, transparent);
  }

  html {
    color: #fff;
  }

  span {
    color: #b3b3b3;
  }

  @font-face {
    font-family: "Monserrat";
  }
</style>
