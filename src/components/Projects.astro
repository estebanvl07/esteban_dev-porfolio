---
import Title from "./Title.astro";
import Button from "./Button.astro";
import clsx from "clsx";

import NextJS from "./icons/NextJS.astro";
import React from "./icons/React.astro";
import tRPC from "./icons/tRPC.astro";
import Tailwind from "./icons/Tailwind.astro";

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  REACT: {
    name: "React JS",
    class: "bg-[#0074a6] text-white",
    icon: React,
  },
  tRPC: {
    name: "tRPC",
    class: "bg-[#3730a3] text-white",
    icon: tRPC,
  },
  PRISMA: {
    name: "Prisma CLI",
    class: "bg-[#2d3748] text-white",
    icon: tRPC,
  },
};

const projects = [
  {
    imageSrc: "/images/projectsImage/biru.png",
    articleProps: {
      title: "Biru",
      description:
        "Esta es una aplicación en desarrollo diseñada para gestión financiera personal. Aunque no está disponible actualmente, pronto estará disponible para los usuarios, proporcionándoles la capacidad de gestionar sus ingresos, gastos y ahorros de manera fácil y eficiente.",
      hasView: true,
      hrefToWebSite: "https://biru-next.vercel.app/",
      tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.tRPC, TAGS.PRISMA],
    },
  },
  {
    imageSrc: "/images/projectsImage/naturalia.png",
    articleProps: {
      title: "Naturalia",
      description:
        "Desarrollé una tienda en línea de productos naturales utilizando Next.js, enfocándome en una navegación rápida y una experiencia de usuario intuitiva. Implementé filtros dinámicos, gestión de productos y una optimización del diseño para mejorar las conversiones.",
      hasView: true,
      hasViewCode: true,
      hrefToWebSite: "https://naturalia.vercel.app",
      hrefToRepository: "https://github.com/estebanvl07/naturalia",
      tags: [TAGS.NEXT, TAGS.TAILWIND],
    },
  },
  {
    imageSrc: "/images/projectsImage/bpox.png",
    articleProps: {
      title: "BPOX",
      description:
        "Plataforma integral para restaurantes diseñada para optimizar la operación diaria y mejorar la experiencia del cliente. Permite gestionar pedidos, mesas, productos y personal desde una interfaz intuitiva y rápida. Incluye herramientas para que los clientes realicen pedidos directamente desde su mesa mediante un código de validación, reduciendo tiempos de espera y aumentando la rotación. El sistema ofrece estadísticas en tiempo real, control de inventario, registro de ventas y monitoreo del desempeño del personal. Ideal para restaurantes medianos, cafeterías y locales de comida rápida que buscan modernizar su flujo de trabajo y aumentar su eficiencia sin necesidad de procesos complejos.",
      hasView: true,
      hasViewCode: false,
      hrefToWebSite: "https://bpox-landing.bpox.site/",
      tags: [TAGS.REACT, TAGS.TAILWIND, TAGS.NEXT, TAGS.tRPC, TAGS.PRISMA],
    },
  },
  {
    imageSrc: "/images/projectsImage/turnal.png",
    articleProps: {
      title: "Turnal",
      description:
        "Aplicación especializada en la gestión de turnos para IPS y centros de atención en salud. Permite organizar agendas, asignar citas y administrar la disponibilidad de profesionales de manera eficiente. Ofrece un panel claro para el personal administrativo y una experiencia fluida para los pacientes, quienes pueden solicitar, reagendar o cancelar turnos de forma sencilla. Incluye notificaciones automáticas, control de asistencia y reportes sobre la demanda de servicios. Optimiza los tiempos de atención, reduce congestiones en recepción y mejora la coordinación interna, adaptándose a las necesidades operativas de cualquier IPS.",
      hasView: true,
      hasViewCode: false,
      hrefToWebSite: "https://turnal.netlify.app/",
      tags: [TAGS.REACT, TAGS.TAILWIND, TAGS.NEXT, TAGS.tRPC, TAGS.PRISMA],
    },
  },
];
---

<div class="min-h-screen h-full py-10 m-auto max-w-[70rem]">
  <Title title="Proyectos" description="Proyectos personales" />
  <section class="flex flex-col w-full gap-20 mt-16">
    {
      projects.map((project, index) => {
        const { imageSrc, articleProps } = project;
        const {
          title,
          description,
          hasView,
          hasViewCode,
          hrefToWebSite,
          hrefToRepository,
          tags,
        } = articleProps;

        const impar = index === 0 ? true : index! % 2 === 0;

        return (
          <article
            class={clsx(
              "w-full flex flex-col md:flex-row-reverse gap-8 justify-between items-center px-8",
              {
                "md:!flex-row": impar,
              },
            )}
          >
            <img
              src={imageSrc}
              loading="lazy"
              class={clsx(
                " max-w-full md:max-w-[30rem] rounded-xl border-4 border-white/10 hover:scale-105 transition-all duration-500",
              )}
            />
            <aside class="w-full flex-1 md:w-1/2 md:max-w-lg">
              <h2 class="text-3xl underline underline-offset-4 text-fuchsia-200 font-bold">
                {title}
              </h2>
              {tags && (
                <ul class="flex flex-wrap gap-2 mt-4">
                  {tags.map((tag: any) => (
                    <li class="flex items-center">
                      <span
                        class={`flex items-center whitespace-nowrap border border-white/20 gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                      >
                        <tag.icon class="size-4" />
                        {tag.name}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
              <p class="text-zinc-300 my-4">{description}</p>
              <nav class="w-full flex flex-col lg:flex-row gap-3">
                {hasView && (
                  <a
                    href={hrefToWebSite}
                    target="_blank"
                    class="w-full md:w-auto"
                  >
                    <Button class="!w-full">
                      <span class="flex gap-2 text-white items-center whitespace-nowrap">
                        Visitar web <img src="/images/web.svg" />
                      </span>
                    </Button>
                  </a>
                )}
                {hasViewCode && (
                  <a
                    href={hrefToRepository}
                    target="_blank"
                    class="w-full md:w-auto"
                  >
                    <Button variant="outline" class="!w-full">
                      <span class="flex gap-2 whitespace-nowrap">
                        github <img src="/images/github.svg" />
                      </span>
                    </Button>
                  </a>
                )}
              </nav>
            </aside>
          </article>
        );
      })
    }
  </section>
</div>
