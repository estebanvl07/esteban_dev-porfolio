---
import clsx from "clsx";
import Button from "./Button.astro";

interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<article
  class={clsx(
    "relative w-full h-full flex items-center justify-center md:justify-start",
    className,
  )}
>
  <div class="absolute inset-0 flex">
    <!-- Fondo negro con fade hacia la imagen -->
    <div class="w-full md:w-1/2 bg-black relative">
      <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-transparent"></div>
    </div>
    
    <!-- Imagen full height con fade negro a transparente -->
    <div class="hidden md:block w-1/2 relative">
      <img
        src="/images/profesionall-photo.png"
        alt="Joel Viloria"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-l from-transparent via-black/20 to-black"></div>
    </div>
  </div>

  <!-- Contenido del texto sobre el fondo negro -->
  <div class="relative z-10 flex flex-col items-center md:items-start px-8 md:px-16 max-w-[70rem]">
    <div class="flex flex-col items-center md:items-start">
      <h1
        class="text-5xl sm:text-5xl md:text-6xl lg:text-[85px] text-center md:text-start font-extrabold text-white"
      >
        <span class="font-title text-3xl sm:text-4xl md:text-5xl lg:text-[65px]"
          >I'M FULL-STACK</span
        >
        <br />
        DEVELOPER
      </h1>
      <p class="max-w-[28rem] text-center md:text-start text-sm md:text-base mt-4 text-white/90">
        +4 años de experiencia. Especializado en el desarrollo de aplicaciones web
        únicas.
      </p>
      <nav class="flex justify-center md:justify-start gap-2 mt-6">
        <a href="/files/Esteban resumen.pdf" target="_blank">
          <Button>DESCARGAR CV</Button>
        </a>
        <a href="mailto:viloriaalgarin@gmail.com">
          <Button variant="outline">CONTACTAME</Button>
        </a>
      </nav>
      <nav
        class="md:mt-10 w-fit z-20 flex gap-2 [&>a>img]:w-7 md:[&>a>img]:w-9 justify-center md:justify-start mt-6"
      >
        <a
          href="https://www.linkedin.com/in/esteban-vl-8a1333223/"
          target="_blank"
          class="hover:scale-105 transition-all duration-300"
        >
          <img src="/images/linkedin.svg" />
        </a>
        <a
          href="https://github.com/estebanvl07"
          target="_blank"
          class="hover:scale-105 transition-all duration-300"
        >
          <img src="/images/github.svg" />
        </a>
      </nav>
    </div>
  </div>
</article>
